{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livesub.local/schemas/language-pack.schema.json",
  "title": "LiveSub validated local language pack",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "language", "display_name", "version", "models", "license", "artifacts", "acceptance", "signature"],
  "properties": {
    "schema_version": { "const": 1 },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)?$" },
    "display_name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]*$" },
    "status": { "enum": ["candidate", "validated"] },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["owner", "repository", "revision", "downloaded_at", "trust_remote_code", "license"],
        "properties": {
          "owner": { "type": "string", "minLength": 1 },
          "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
          "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "downloaded_at": { "type": "string", "format": "date-time" },
          "trust_remote_code": { "const": false },
          "license": {
            "type": "object",
            "required": ["spdx", "commercial_use_allowed", "redistribution_allowed"],
            "properties": {
              "spdx": { "type": "string" },
              "commercial_use_allowed": { "const": true },
              "redistribution_allowed": { "const": true }
            }
          }
        }
      }
    },
    "license": {
      "type": "object",
      "required": ["commercial_use_allowed", "redistribution_allowed"],
      "properties": {
        "commercial_use_allowed": { "const": true },
        "redistribution_allowed": { "const": true }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "passed", "failed"] },
        "corpus_revision": { "type": ["string", "null"] },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "report_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "status", "value"]
    }
  }
}
